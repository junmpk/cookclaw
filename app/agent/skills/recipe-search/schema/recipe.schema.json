        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "group": {
          "default": "main",
          "title": "Group",
          "type": "string"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "allergen": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
