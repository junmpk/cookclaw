# Local service
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Qwen / DashScope. Replace locally; never commit the real value.
DASHSCOPE_API_KEY=replace_me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_PROFILE=qwen
LLM_MODEL=qwen3.7-plus
QA_MODEL=qwen-plus
INTENT_MODEL=qwen-plus

# Recipe retrieval. Supply your own authorized data.
RECIPE_MILVUS_URI=recipe_milvus.db
MILVUS_HYBRID_COLLECTION=recipe_hybrid
MILVUS_COLLECTION=recipe_collection
MILVUS_VECTOR_DIM=1024
EMBEDDING_MODEL=text-embedding-v4
RECIPE_SEARCH_INPROCESS=1
RECIPE_SEARCH_CONCURRENCY=1

# Local development defaults. External stores can be configured separately.
CONVERSATION_STORE=memory
PROFILE_STORE=memory
CONVERSATION_STORAGE_REQUIRED=false
TURN_PLANNER_MODE=off
TURN_PLANNER_ACTIVE_ROLLOUT_PERCENT=0
CONVERSATION_DEEP_AGENT_ENABLED=false
CONVERSATION_GENERAL_MEMORY_ENABLED=false

# All real messaging channels are opt-in and require your own credentials.
QQ_BOT_ENABLED=false
WHATSAPP_ENABLED=false
WEIXIN_ENABLED=false

# Optional interview/demo rollout: route explicit multi-agent menu requests from
# QQ/Weixin/WhatsApp into the same LangGraph used by the Web showcase.
MULTI_AGENT_BRIDGE_ENABLED=false
MULTI_AGENT_BRIDGE_MODE=live
# MULTI_AGENT_DATA_DIR=/absolute/path/to/this/repository/.demo

# Public edition uses a local mock-device adapter only.
COOKCLAW_DEVICE_PROVIDER=mock
