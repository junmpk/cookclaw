# Independent demo configuration. Copy to .env.demo, never commit credentials.
DASHSCOPE_API_KEY=replace_me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEMO_MODEL=qwen3.7-flash-2026-07-15
# auto: use CookClaw hybrid RAG when RECIPE_MILVUS_URI is ready, otherwise use
# the bundled public rehearsal collection. Set hybrid to fail closed instead.
DEMO_RECIPE_BACKEND=auto
# Public data may omit production recipe steps. When true, scheduling can use
# clearly labelled demo-only templates; they never become recipe facts or device commands.
DEMO_VIRTUAL_SCHEDULE=true
# Optional IM bridge. It uses the same DEMO_RECIPE_BACKEND as Web.
# MULTI_AGENT_BRIDGE_ENABLED=true
# MULTI_AGENT_BRIDGE_MODE=live
# Optional absolute path; defaults to this public checkout's .demo directory.
# DEMO_DATA_DIR=/absolute/local/path
